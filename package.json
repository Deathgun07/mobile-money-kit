{
  "name": "mobile-money-kit",
  "version": "0.3.1",
  "private": true,
  "description": "SDK XPAYE (Paiement Pro) pour encaisser par Mobile Money, carte et PayPal en Afrique de l'Ouest et centrale (Orange Money, MTN MoMo, Moov/Flooz, Wave…), notifications sécurisées, CinetPay en secours facultatif. Node 18+ et Bun.",
  "keywords": [
    "xpaye",
    "paiementpro",
    "paiement-pro",
    "mobile-money",
    "orange-money",
    "mtn-momo",
    "moov-money",
    "wave",
    "paiement",
    "payment",
    "fcfa",
    "xof",
    "cinetpay",
    "cote-d-ivoire",
    "afrique",
    "webhook",
    "bun"
  ],
  "license": "MIT",
  "author": "Deathgun07",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && node --test test/*.test.mjs",
    "test:bun": "tsc && bun test ./test/sdk.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deathgun07/mobile-money-kit.git"
  },
  "homepage": "https://github.com/Deathgun07/mobile-money-kit#readme",
  "bugs": {
    "url": "https://github.com/Deathgun07/mobile-money-kit/issues"
  }
}
